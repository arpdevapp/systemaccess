# SystemAccess Environment Configuration
# Copy this file to .env and modify as needed

# Signaling Server Configuration
SIGNALING_SERVER_PORT=3001
SIGNALING_SERVER_HOST=localhost

# React App Configuration
REACT_APP_PORT=5173
REACT_APP_SIGNALING_URL=http://localhost:3001

# WebRTC Configuration
REACT_APP_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
REACT_APP_TURN_SERVER=
REACT_APP_TURN_USERNAME=
REACT_APP_TURN_PASSWORD=

# Development Settings
NODE_ENV=development
DEBUG=false

# Security Settings
CORS_ORIGIN=*
ENABLE_HTTPS=false
SSL_CERT_PATH=
SSL_KEY_PATH=
